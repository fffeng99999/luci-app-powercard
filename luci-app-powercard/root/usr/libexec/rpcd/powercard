#!/bin/sh
#
# rpcd backend for luci-app-powercard
#
# Proxies the HTTP API of the ESP8266 PC PowerCard so that the browser
# only talks to LuCI same-origin (the ESP firmware sends no CORS header).
#
# Device address is read from /etc/config/powercard:
#	config powercard 'main'
#		option ip      '192.168.58.246'
#		option port    '80'
#		option timeout '5'
#		option watchdog_enabled '1'   # force-off safety net
#		option watchdog_minutes '10'  # grace period after a soft shutdown
#		option sched_precheck  '1'    # skip scheduled on/off when the
#		                              # PC already is in that state
#
# Scheduled power on/off rules live in /etc/config/powercard as
# 'schedule' sections and are synced into the root crontab:
#	config schedule
#		option enabled  '1'
#		option time     '08:00'
#		option action   'on'          # on | off | force
#		option weekdays '1,2,3,4,5'  # cron style, 0=Sunday
#
# Manual test:
#	echo '{}' | ubus call powercard status
#	echo '{"type":"on"}' | ubus call powercard power
#	echo '{"type":"custom","ms":2000}' | ubus call powercard power
#	echo '{}' | ubus call powercard reset
#	echo '{}' | ubus call powercard get_schedule
#	echo '{"count":1,"rules":[{"enabled":"1","time":"08:00","action":"on","weekdays":"1,2,3,4,5"}]}' \
#		| ubus call powercard set_schedule
#	echo '{}' | ubus call powercard get_watchdog
#	echo '{"enabled":"1","minutes":"10"}' | ubus call powercard set_watchdog
#
# The same script is invoked directly (not via rpcd) by cron and by the
# package postinst:
#	/usr/libexec/rpcd/powercard run_scheduled on   # scheduled action
#	/usr/libexec/rpcd/powercard watchdog_tick      # every minute
#	/usr/libexec/rpcd/powercard ensure_cron        # (re)install cron lines

set -u

PATH="/usr/sbin:/usr/bin:/sbin:/bin:${PATH:-}"
export PATH

CONFIG="powercard"
DEFAULT_IP="192.168.58.246"
DEFAULT_WATCHDOG_MINUTES="10"

CFG_IP="$DEFAULT_IP"
CFG_PORT="80"
CFG_TIMEOUT="5"
CFG_WATCHDOG_ENABLED="1"
CFG_WATCHDOG_MINUTES="$DEFAULT_WATCHDOG_MINUTES"
CFG_SCHED_PRECHECK="1"

# Where the pending "soft shutdown was sent" marker lives. /tmp is a tmpfs:
# it is cleared on router reboot, which is the desired behaviour.
WATCHDOG_STATE="/tmp/powercard-watchdog"

read_config() {
	local ip port timeout wd_en wd_min pre

	ip=$(uci -q get "$CONFIG.main.ip" 2>/dev/null)
	port=$(uci -q get "$CONFIG.main.port" 2>/dev/null)
	timeout=$(uci -q get "$CONFIG.main.timeout" 2>/dev/null)
	wd_en=$(uci -q get "$CONFIG.main.watchdog_enabled" 2>/dev/null)
	wd_min=$(uci -q get "$CONFIG.main.watchdog_minutes" 2>/dev/null)
	pre=$(uci -q get "$CONFIG.main.sched_precheck" 2>/dev/null)

	[ -n "$ip" ] && CFG_IP="$ip"
	[ -n "$port" ] && CFG_PORT="$port"
	[ -n "$timeout" ] && CFG_TIMEOUT="$timeout"
	[ -n "$wd_en" ] && CFG_WATCHDOG_ENABLED="$wd_en"
	[ -n "$wd_min" ] && CFG_WATCHDOG_MINUTES="$wd_min"
	[ -n "$pre" ] && CFG_SCHED_PRECHECK="$pre"
}

# Minimal JSON string escaper (backslash / double quote).
json_escape() {
	printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

# Strict dotted-quad IPv4 check. Returns 0 when valid.
valid_ip() {
	local ip="$1" count=0 oct oldifs

	case "$ip" in
		'' | *[!0-9.]* | *..* | .* | *.)
			return 1
			;;
	esac

	oldifs="$IFS"
	IFS='.'
	for oct in $ip; do
		count=$((count + 1))
		[ ${#oct} -ge 1 ] && [ ${#oct} -le 3 ] || { IFS="$oldifs"; return 1; }
		case "$oct" in
			*[!0-9]*)
				IFS="$oldifs"
				return 1
				;;
		esac
		[ "$oct" -le 255 ] || { IFS="$oldifs"; return 1; }
	done
	IFS="$oldifs"

	[ "$count" -eq 4 ]
}

# Unsigned integer within [min, max]. Returns 0 when valid.
valid_uint() {
	case "$1" in
		'' | *[!0-9]*)
			return 1
			;;
	esac
	[ "$1" -ge "$2" ] 2>/dev/null && [ "$1" -le "$3" ] 2>/dev/null
}

# HH:MM, 24-hour clock. Returns 0 when valid.
valid_time() {
	local hh mm

	case "$1" in
		[0-9][0-9]:[0-9][0-9]) ;;
		*) return 1 ;;
	esac

	hh=${1%%:*}
	mm=${1##*:}

	# Strip one leading zero; keeps "08"/"09" out of octal territory.
	hh=${hh#0}
	mm=${mm#0}
	[ -n "$hh" ] || hh=0
	[ -n "$mm" ] || mm=0

	[ "$hh" -le 23 ] && [ "$mm" -le 59 ]
}

# "HH:MM" -> "HH MM" with leading zeros stripped, for the cron fields.
time_to_cron() {
	local hh mm

	hh=${1%%:*}
	mm=${1##*:}
	hh=${hh#0}
	mm=${mm#0}
	[ -n "$hh" ] || hh=0
	[ -n "$mm" ] || mm=0

	printf '%s %s' "$hh" "$mm"
}

# Day-of-week specification. Two accepted forms:
#   7-char mask "1111100"  - position 0..6 = Sunday..Saturday, 1=selected
#   cron list   "0,6" / "*" - digits 0-7 (0 and 7 = Sunday), commas, ranges
# Returns 0 when valid.
valid_weekdays() {
	local part="$1" tok oldifs

	[ "$part" = "*" ] && return 0

	# 7-bit mask form
	case "$part" in
		[01][01][01][01][01][01][01])
			return 0
			;;
	esac

	# Cron list form
	case "$part" in
		'' | *[!0-7,\-]*)
			return 1
			;;
	esac

	oldifs="$IFS"
	IFS=','
	for tok in $part; do
		case "$tok" in
			[0-7]) ;;
			[0-7]-[0-7])
				[ "${tok%%-*}" -le "${tok##*-}" ] || { IFS="$oldifs"; return 1; }
				;;
			*) IFS="$oldifs"; return 1 ;;
		esac
	done
	IFS="$oldifs"

	return 0
}

# Expand any accepted weekday form to a cron day-of-week field.
weekdays_to_cron() {
	local part="$1" out="" i=0 rest c

	if [ "$part" = "*" ]; then
		printf '*'
		return 0
	fi

	case "$part" in
		[01][01][01][01][01][01][01])
			rest="$part"
			while [ -n "$rest" ]; do
				# c = first char of rest (ash has no ${s:i:1})
				c=${rest%"${rest#?}"}
				[ "$c" = "1" ] && out="$out,$i"
				rest=${rest#?}
				i=$((i + 1))
			done
			out=${out#,}
			if [ -z "$out" ]; then
				printf '*'
			else
				printf '%s' "$out"
			fi
			return 0
			;;
	esac

	printf '%s' "$part"
}

read_watchdog_state() {
	local armed="" now elapsed limit mins="$CFG_WATCHDOG_MINUTES"

	WATCHDOG_ARMED=false
	WATCHDOG_REMAINING=0
	case "$mins" in
		'' | *[!0-9]*) mins="$DEFAULT_WATCHDOG_MINUTES" ;;
	esac

	[ -f "$WATCHDOG_STATE" ] || return 0
	armed=$(cat "$WATCHDOG_STATE" 2>/dev/null)
	case "$armed" in
		'' | *[!0-9]*) return 0 ;;
	esac

	now=$(date +%s 2>/dev/null) || now=0
	elapsed=$((now - armed))
	limit=$((mins * 60))
	WATCHDOG_REMAINING=$((limit - elapsed))
	[ "$WATCHDOG_REMAINING" -ge 0 ] || WATCHDOG_REMAINING=0
	WATCHDOG_ARMED=true
}

do_get_config() {
	read_config
	[ "$CFG_WATCHDOG_ENABLED" = "1" ] || CFG_WATCHDOG_ENABLED="0"
	[ "$CFG_SCHED_PRECHECK" = "0" ] || CFG_SCHED_PRECHECK="1"
	read_watchdog_state

	# Keep the original address fields and append the newer settings.  The UI
	# deliberately uses this original RPC so sessions created before an upgrade
	# can still read and save every option with their cached ACL.
	printf '{"ip":"%s","port":"%s","timeout":"%s","watchdog_enabled":"%s","watchdog_minutes":"%s","precheck":"%s","armed":%s,"remaining":%s,"rules":[' \
		"$CFG_IP" "$CFG_PORT" "$CFG_TIMEOUT" \
		"$CFG_WATCHDOG_ENABLED" "$CFG_WATCHDOG_MINUTES" "$CFG_SCHED_PRECHECK" \
		"$WATCHDOG_ARMED" "$WATCHDOG_REMAINING"
	print_schedule_rules
	printf ']}\n'
}

do_set_config() {
	local input ip port timeout watchdog_enabled watchdog_minutes precheck

	read -r input
	ip=$(printf '%s' "$input" | jsonfilter -e '@.ip' 2>/dev/null)
	port=$(printf '%s' "$input" | jsonfilter -e '@.port' 2>/dev/null)
	timeout=$(printf '%s' "$input" | jsonfilter -e '@.timeout' 2>/dev/null)
	watchdog_enabled=$(printf '%s' "$input" | jsonfilter -e '@.watchdog_enabled' 2>/dev/null)
	watchdog_minutes=$(printf '%s' "$input" | jsonfilter -e '@.watchdog_minutes' 2>/dev/null)
	precheck=$(printf '%s' "$input" | jsonfilter -e '@.precheck' 2>/dev/null)

	# Settings-only calls do not need to resend the device address.  Route them
	# through the same validators used by the backwards-compatible RPC methods.
	if [ -z "$ip" ] && [ -z "$port" ] && [ -z "$timeout" ]; then
		if [ -n "$watchdog_enabled" ] || [ -n "$watchdog_minutes" ]; then
			set_watchdog_input "$input"
			return 0
		fi
		if [ -n "$precheck" ]; then
			set_schedule_input "$input"
			return 0
		fi
	fi

	if ! valid_ip "$ip"; then
		emit_error "IP 地址格式不正确"
		return 0
	fi

	# Port/timeout are optional: keep existing value when omitted.
	if [ -n "$port" ]; then
		valid_uint "$port" 1 65535 || { emit_error "端口必须是 1~65535 的数字"; return 0; }
	fi
	if [ -n "$timeout" ]; then
		valid_uint "$timeout" 1 30 || { emit_error "超时必须是 1~30 秒"; return 0; }
	fi

	# Values are strictly validated above, so they are shell/uci safe.
	read_config
	uci set "$CONFIG.main.ip=$ip" || { emit_error "写入配置失败"; return 0; }
	[ -n "$port" ] && uci set "$CONFIG.main.port=$port"
	[ -n "$timeout" ] && uci set "$CONFIG.main.timeout=$timeout"

	if uci commit "$CONFIG"; then
		emit_ok_msg "设备地址已保存"
	else
		emit_error "保存配置失败"
	fi
}

emit_error() {
	printf '{"ok":false,"msg":"%s"}\n' "$(json_escape "$1")"
}

emit_ok_msg() {
	printf '{"ok":true,"msg":"%s"}\n' "$(json_escape "$1")"
}

# ---------------------------------------------------------------------------
# Scheduled power on/off (multiple rules -> /etc/crontabs/root)
# ---------------------------------------------------------------------------

CRON_TAG="# powercard-schedule"
MAX_RULES=32
CRON_HELPER="/usr/libexec/rpcd/powercard"

# Names of all schedule sections currently stored in uci.
schedule_sections() {
	uci -q show "$CONFIG" 2>/dev/null |
		sed -n "s/^$CONFIG\.\([A-Za-z0-9_]*\)=schedule$/\1/p"
}

# Rebuild the powercard block inside the root crontab from uci.
sync_cron() {
	local crontab="/etc/crontabs/root" tmp sec action tm weekdays dow enabled
	local hh mm hm

	tmp=$(mktemp /tmp/powercard-cron.XXXXXX) || return 1

	# Keep every existing line that does not belong to this plugin.
	if [ -f "$crontab" ]; then
		grep -vF "$CRON_TAG" "$crontab" > "$tmp" 2>/dev/null
	else
		: > "$tmp"
	fi

	for sec in $(schedule_sections); do
		enabled=$(uci -q get "$CONFIG.$sec.enabled")
		[ "$enabled" = "0" ] && continue

		action=$(uci -q get "$CONFIG.$sec.action")
		tm=$(uci -q get "$CONFIG.$sec.time")
		weekdays=$(uci -q get "$CONFIG.$sec.weekdays")

		valid_time "$tm" || continue
		[ -n "$weekdays" ] || weekdays="*"
		valid_weekdays "$weekdays" || continue

		case "$action" in
			on | off | force) ;;
			*) continue ;;
		esac

		dow=$(weekdays_to_cron "$weekdays")
		hm=$(time_to_cron "$tm")
		hh=${hm%% *}
		mm=${hm##* }

		printf '%s %s * * %s %s run_scheduled %s %s\n' \
			"$mm" "$hh" "$dow" "$CRON_HELPER" "$action" "$CRON_TAG" >> "$tmp"
	done

	# Per-minute shutdown-watchdog tick (only when the feature is on).
	read_config
	if [ "$CFG_WATCHDOG_ENABLED" = "1" ]; then
		printf '* * * * * %s watchdog_tick %s\n' \
			"$CRON_HELPER" "$CRON_TAG" >> "$tmp"
	fi

	mkdir -p /etc/crontabs 2>/dev/null
	cat "$tmp" > "$crontab"
	chmod 0600 "$crontab" 2>/dev/null
	rm -f "$tmp"

	# busybox crond picks up changes on restart; also enable it so the
	# crontab survives a router reboot.
	if [ -x /etc/init.d/cron ]; then
		/etc/init.d/cron enable >/dev/null 2>&1
		/etc/init.d/cron restart >/dev/null 2>&1
	fi
	return 0
}

print_schedule_rules() {
	local first=1 sec action tm weekdays enabled

	for sec in $(schedule_sections); do
		action=$(uci -q get "$CONFIG.$sec.action")
		tm=$(uci -q get "$CONFIG.$sec.time")
		weekdays=$(uci -q get "$CONFIG.$sec.weekdays")
		enabled=$(uci -q get "$CONFIG.$sec.enabled")

		[ -n "$weekdays" ] || weekdays="*"
		[ "$enabled" = "0" ] || enabled="1"

		[ $first -eq 1 ] || printf ','
		first=0
		printf '{"id":"%s","enabled":"%s","time":"%s","action":"%s","weekdays":"%s"}' \
			"$sec" "$enabled" "$tm" "$action" "$weekdays"
	done
}

do_get_schedule() {
	local precheck

	read_config
	[ "$CFG_SCHED_PRECHECK" = "1" ] && precheck=1 || precheck=0

	printf '{"precheck":"%s","rules":[' "$precheck"
	print_schedule_rules
	printf ']}\n'
}

# Input: {"rules":[{"enabled":"1","time":"08:00","action":"on","weekdays":"1-5"},...]}
# The list fully replaces the stored schedule.
set_schedule_input() {
	local input="$1" idx=0 n=0 action tm weekdays enabled sec

	# jsonfilter exposes neither array length nor multiple expressions,
	# so probe the indexes one field at a time and validate as we go.
	while :; do
		action=$(printf '%s' "$input" | jsonfilter -e "@.rules[$idx].action" 2>/dev/null)
		tm=$(printf '%s' "$input" | jsonfilter -e "@.rules[$idx].time" 2>/dev/null)

		[ -n "$action" ] || [ -n "$tm" ] || break

		if [ "$idx" -ge "$MAX_RULES" ]; then
			emit_error "最多支持 $MAX_RULES 条定时规则"
			return 0
		fi

		weekdays=$(printf '%s' "$input" | jsonfilter -e "@.rules[$idx].weekdays" 2>/dev/null)
		enabled=$(printf '%s' "$input" | jsonfilter -e "@.rules[$idx].enabled" 2>/dev/null)

		[ -n "$weekdays" ] || weekdays="*"

		valid_time "$tm" || { emit_error "第 $((idx + 1)) 条规则的时间格式不正确（应为 HH:MM）"; return 0; }
		case "$action" in
			on | off | force) ;;
			*) emit_error "第 $((idx + 1)) 条规则的动作无效"; return 0 ;;
		esac
		valid_weekdays "$weekdays" || { emit_error "第 $((idx + 1)) 条规则的重复周期不正确"; return 0; }

		idx=$((idx + 1))
	done

	# Remove old sections and write the new ones with stable names.
	for sec in $(schedule_sections); do
		uci -q delete "$CONFIG.$sec"
	done

	while [ "$n" -lt "$idx" ]; do
		action=$(printf '%s' "$input" | jsonfilter -e "@.rules[$n].action" 2>/dev/null)
		tm=$(printf '%s' "$input" | jsonfilter -e "@.rules[$n].time" 2>/dev/null)
		weekdays=$(printf '%s' "$input" | jsonfilter -e "@.rules[$n].weekdays" 2>/dev/null)
		enabled=$(printf '%s' "$input" | jsonfilter -e "@.rules[$n].enabled" 2>/dev/null)

		[ -n "$weekdays" ] || weekdays="*"
		if [ "$enabled" = "0" ] || [ "$enabled" = "false" ]; then
			enabled=0
		else
			enabled=1
		fi

		sec="rule$((n + 1))"
		uci -q set "$CONFIG.$sec=schedule"
		uci set "$CONFIG.$sec.enabled=$enabled"
		uci set "$CONFIG.$sec.time=$tm"
		uci set "$CONFIG.$sec.action=$action"
		uci set "$CONFIG.$sec.weekdays=$weekdays"

		n=$((n + 1))
	done

	if ! uci commit "$CONFIG"; then
		emit_error "保存定时规则失败"
		return 0
	fi

	# The precheck switch is stored on the main section, saved alongside
	# the rules so the frontend can keep both in one card.
	local precheck
	precheck=$(printf '%s' "$input" | jsonfilter -e '@.precheck' 2>/dev/null)
	if [ -n "$precheck" ]; then
		if [ "$precheck" = "0" ] || [ "$precheck" = "false" ]; then
			uci set "$CONFIG.main.sched_precheck=0"
		else
			uci set "$CONFIG.main.sched_precheck=1"
		fi
		uci commit "$CONFIG" || { emit_error "保存设置失败"; return 0; }
	fi

	sync_cron
	emit_ok_msg "定时规则已保存（共 $idx 条）"
}

do_set_schedule() {
	local input
	read -r input
	set_schedule_input "$input"
}

# Invoked by cron. $1 = on|off|force. Runs standalone, outside rpcd.
#
# Before firing, the current power state is checked (unless disabled via
# sched_precheck). The POWER pin is a single toggle, so sending "on" to a
# machine that is already on - or "off" to one already off - would do the
# wrong thing. In that case the scheduled action is skipped and logged.
do_run_scheduled() {
	local type="${1:-}"

	case "$type" in
		on | off | force) ;;
		*) exit 0 ;;
	esac

	read_config

	# Pre-check: skip a redundant on/off. "force" always runs (it is the
	# user's explicit "the machine is stuck, cut power" escape hatch).
	if [ "$CFG_SCHED_PRECHECK" = "1" ] && [ "$type" != "force" ]; then
		local pc_state
		pc_state=$(read_pc_state)

		case "$pc_state" in
			on)
				if [ "$type" = "on" ]; then
					logger -t powercard \
						"scheduled '$type' skipped: PC already on"
					exit 0
				fi
				;;
			off)
				if [ "$type" = "off" ]; then
					logger -t powercard \
						"scheduled '$type' skipped: PC already off"
					exit 0
				fi
				;;
			unknown)
				# Card unreachable: do not guess. Log and skip so we
				# never fire a toggle against an unknown state.
				logger -t powercard \
					"scheduled '$type' skipped: power state unknown (card unreachable)"
				exit 0
				;;
		esac
	fi

	local BODY
	BODY=$(http_post "/api/power" "type=$type" 2>/dev/null)
	[ -n "$BODY" ] ||
		logger -t powercard "scheduled action '$type' failed"

	# A soft shutdown may leave the board spinning: arm the watchdog,
	# but only when the command actually reached the card.
	[ "$type" = "off" ] && [ -n "$BODY" ] && watchdog_arm

	exit 0
}

# Query the card and echo the PC power state as one of: on | off | unknown.
# "unknown" means the card could not be reached or its reply was unusable,
# so callers must not assume either state.
read_pc_state() {
	local body pc_on

	body=$(http_get "/api/status")
	[ -n "$body" ] || { printf 'unknown'; return 0; }

	pc_on=$(printf '%s' "$body" | jsonfilter -e '@.pc_on' 2>/dev/null)

	case "$pc_on" in
		true | 1) printf 'on' ;;
		false | 0) printf 'off' ;;
		*) printf 'unknown' ;;
	esac
}

# ---------------------------------------------------------------------------
# Shutdown watchdog
#
# After any soft power-off (manual button or scheduled 'off'), arm a timer.
# A per-minute cron tick checks the marker; once the grace period has elapsed
# and the card still reports the PC as ON, it fires a single force shutdown.
# The marker lives in tmpfs, so a router reboot clears any stale timer.
# ---------------------------------------------------------------------------

# Arm the watchdog: record the current epoch in the marker file.
watchdog_arm() {
	read_config
	[ "$CFG_WATCHDOG_ENABLED" = "1" ] || return 0

	local now
	now=$(date +%s 2>/dev/null) || return 0
	printf '%s\n' "$now" > "$WATCHDOG_STATE" 2>/dev/null
}

# Disarm the watchdog (e.g. the user powers the machine back on).
watchdog_clear() {
	rm -f "$WATCHDOG_STATE" 2>/dev/null
}

# Per-minute cron callback.
do_watchdog_tick() {
	local armed now elapsed limit mins pc_on

	[ -f "$WATCHDOG_STATE" ] || exit 0

	read_config
	if [ "$CFG_WATCHDOG_ENABLED" != "1" ]; then
		watchdog_clear
		exit 0
	fi

	armed=$(cat "$WATCHDOG_STATE" 2>/dev/null)
	case "$armed" in
		'' | *[!0-9]*) watchdog_clear; exit 0 ;;
	esac

	now=$(date +%s 2>/dev/null) || exit 0
	elapsed=$((now - armed))

	mins="$CFG_WATCHDOG_MINUTES"
	case "$mins" in
		'' | *[!0-9]*) mins="$DEFAULT_WATCHDOG_MINUTES" ;;
	esac
	limit=$((mins * 60))

	# Not yet due.
	[ "$elapsed" -ge "$limit" ] || exit 0

	# Due: ask the card whether the PC is still on.
	local BODY
	BODY=$(http_get "/api/status")
	if [ -z "$BODY" ]; then
		# Card unreachable: keep the marker and retry on the next tick.
		exit 0
	fi

	pc_on=$(printf '%s' "$BODY" | jsonfilter -e '@.pc_on' 2>/dev/null)

	# The firmware reports this as a JSON boolean or as 0/1; an empty
	# value means the reply could not be parsed, so treat it like an
	# unreachable card and retry instead of silently clearing the timer.
	case "$pc_on" in
		true | 1)
			http_post "/api/power" "type=force" >/dev/null 2>&1
			logger -t powercard \
				"watchdog: PC still on after ${mins}min, forced power off"
			watchdog_clear
			;;
		false | 0)
			logger -t powercard \
				"watchdog: soft shutdown completed within ${mins}min"
			watchdog_clear
			;;
	esac

	exit 0
}

do_get_watchdog() {
	read_config
	local mins="$CFG_WATCHDOG_MINUTES"
	case "$mins" in
		'' | *[!0-9]*) mins="$DEFAULT_WATCHDOG_MINUTES" ;;
	esac
	[ "$CFG_WATCHDOG_ENABLED" = "1" ] || CFG_WATCHDOG_ENABLED="0"
	read_watchdog_state

	printf '{"enabled":"%s","minutes":"%s","armed":%s,"remaining":%s}\n' \
		"$CFG_WATCHDOG_ENABLED" "$mins" "$WATCHDOG_ARMED" "$WATCHDOG_REMAINING"
}

# Input: {"enabled":"1","minutes":"10"} - both fields optional.
set_watchdog_input() {
	local input="$1" enabled minutes
	enabled=$(printf '%s' "$input" | jsonfilter -e '@.enabled' 2>/dev/null)
	minutes=$(printf '%s' "$input" | jsonfilter -e '@.minutes' 2>/dev/null)
	[ -n "$enabled" ] || enabled=$(printf '%s' "$input" | jsonfilter -e '@.watchdog_enabled' 2>/dev/null)
	[ -n "$minutes" ] || minutes=$(printf '%s' "$input" | jsonfilter -e '@.watchdog_minutes' 2>/dev/null)

	if [ "$enabled" = "0" ] || [ "$enabled" = "false" ]; then
		enabled=0
	elif [ -n "$enabled" ]; then
		enabled=1
	fi

	if [ -n "$minutes" ]; then
		valid_uint "$minutes" 1 180 || { emit_error "等待时间必须是 1~180 分钟"; return 0; }
	fi

	read_config
	[ -n "$enabled" ] && uci set "$CONFIG.main.watchdog_enabled=$enabled"
	[ -n "$minutes" ] && uci set "$CONFIG.main.watchdog_minutes=$minutes"

	# Turning the feature off should also drop any pending timer.
	[ "$enabled" = "0" ] && watchdog_clear

	if uci commit "$CONFIG"; then
		# The per-minute tick line depends on the enabled flag.
		sync_cron
		emit_ok_msg "关机保护设置已保存"
	else
		emit_error "保存设置失败"
	fi
}

do_set_watchdog() {
	local input
	read -r input
	set_watchdog_input "$input"
}

# (Re)install the powercard cron lines. Called by sync_cron and by the
# package postinst so the per-minute watchdog tick is always present.
ensure_cron() {
	sync_cron
}



# HTTP transport: prefer curl. The card's tiny HTTP server rejects
# POST requests made by some uclient-fetch builds (it requires an
# explicit application/x-www-form-urlencoded Content-Type and is
# picky about the request framing); curl works reliably.
HAVE_CURL=0
if [ -x /usr/bin/curl ]; then
	HAVE_CURL=1
fi

# http_get <path>
http_get() {
	if [ "$HAVE_CURL" = 1 ]; then
		curl -sS --max-time "$CFG_TIMEOUT" \
			"http://$CFG_IP:$CFG_PORT$1" 2>/dev/null
	else
		uclient-fetch -q --timeout="$CFG_TIMEOUT" -O - \
			"http://$CFG_IP:$CFG_PORT$1" 2>/dev/null
	fi
}

# http_post <path> <body>
http_post() {
	if [ "$HAVE_CURL" = 1 ]; then
		curl -sS --max-time "$CFG_TIMEOUT" \
			-H 'Content-Type: application/x-www-form-urlencoded' \
			--data "$2" \
			"http://$CFG_IP:$CFG_PORT$1" 2>/dev/null
	else
		uclient-fetch -q --timeout="$CFG_TIMEOUT" -O - \
			--header='Content-Type: application/x-www-form-urlencoded' \
			--post-data="$2" \
			"http://$CFG_IP:$CFG_PORT$1" 2>/dev/null
	fi
}

# Pass a JSON body through untouched, otherwise report connection error.
# $1 = context message suffix
output_body_or_error() {
	if [ -n "$BODY" ]; then
		printf '%s\n' "$BODY"
	else
		emit_error "无法连接开机卡（$CFG_IP），请检查设备与设置"
	fi
}

do_status() {
	read_config
	BODY=$(http_get "/api/status")
	output_body_or_error
}

do_power() {
	local input type ms data

	read -r input
	type=$(printf '%s' "$input" | jsonfilter -e '@.type' 2>/dev/null)
	ms=$(printf '%s' "$input" | jsonfilter -e '@.ms' 2>/dev/null)

	case "$type" in
		on | off | force)
			;;
		custom)
			case "$ms" in
				'' | *[!0-9]*)
					emit_error "参数 ms 必须是数字"
					return 0
					;;
			esac
			if [ "$ms" -lt 100 ] || [ "$ms" -gt 15000 ]; then
				emit_error "按键时长必须在 100~15000 毫秒之间"
				return 0
			fi
			;;
		*)
			emit_error "无效的操作类型: $type"
			return 0
			;;
	esac

	read_config
	data="type=$type"
	[ "$type" = "custom" ] && data="$data&ms=$ms"

	BODY=$(http_post "/api/power" "$data")
	output_body_or_error

	# Shutdown watchdog: arm only when the soft power-off actually reached
	# the card; disarm after a power-on or a manual force-off.
	if [ -n "$BODY" ]; then
		case "$type" in
			off)        watchdog_arm ;;
			on | force) watchdog_clear ;;
		esac
	fi
}

# The card reboots on these calls and usually drops the connection,
# so a missing reply is treated as success, matching the original page.
do_reset() {
	read_config
	BODY=$(http_post "/api/reset" "x=1")
	if [ -n "$BODY" ]; then
		printf '%s\n' "$BODY"
	else
		emit_ok_msg "开机卡正在重启"
	fi
}

do_clear_wifi() {
	read_config
	BODY=$(http_post "/api/clear_wifi" "x=1")
	if [ -n "$BODY" ]; then
		printf '%s\n' "$BODY"
	else
		emit_ok_msg "WiFi 已清除，设备进入配网模式"
	fi
}

case "${1:-}" in
	list)
		printf '{"status":{},"get_config":{},"set_config":{"ip":"","port":0,"timeout":0,"watchdog_enabled":"","watchdog_minutes":0,"rules":[],"precheck":""},"power":{"type":"","ms":0},"reset":{},"clear_wifi":{},"get_schedule":{},"set_schedule":{"rules":[],"precheck":""},"get_watchdog":{},"set_watchdog":{"enabled":"","minutes":0}}\n'
		;;
	call)
		case "${2:-}" in
			status)        do_status ;;
			get_config)    do_get_config ;;
			set_config)    do_set_config ;;
			power)         do_power ;;
			reset)         do_reset ;;
			clear_wifi)    do_clear_wifi ;;
			get_schedule)  do_get_schedule ;;
			set_schedule)  do_set_schedule ;;
			get_watchdog)  do_get_watchdog ;;
			set_watchdog)  do_set_watchdog ;;
			*)             printf '{}\n' ;;
		esac
		;;
	run_scheduled)
		# Direct invocation from cron, not via rpcd.
		do_run_scheduled "${2:-}"
		;;
	watchdog_tick)
		# Direct invocation from cron, every minute.
		do_watchdog_tick
		;;
	ensure_cron)
		# Direct invocation from postinst / manual repair.
		read_config
		ensure_cron
		;;
esac

exit 0
